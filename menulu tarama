def icon(name: str) -> QIcon:
    p = ICON_DIR / name
    return QIcon(str(p)) if p.exists() else QIcon()

def read_json(path: Path, default):
    if path.exists():
        try:
            return json.loads(path.read_text(encoding="utf-8"))
        except Exception:
            return default
    return default

def write_json(path: Path, data):
    path.write_text(json.dumps(data, ensure_ascii=False, indent=2), encoding="utf-8")

def load_servers() -> List[Dict[str, Any]]:
    return read_json(SERVER_JSON, [])

def save_servers(servers: List[Dict[str, Any]]):
    write_json(SERVER_JSON, servers)

def load_combos() -> List[Dict[str, Any]]:
    return read_json(COMBO_JSON, [])

def save_combos(combos: List[Dict[str, Any]]):
    write_json(COMBO_JSON, combos)


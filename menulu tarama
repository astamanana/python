    def _on_cat_checkbox_change(self, state):
        enabled = self.chk_cat.isChecked()
        self.chk_hide_adult.setEnabled(enabled)
        self.chk_only_tr.setEnabled(enabled)

    def change_hit_sound(self):
        global HIT_SOUND_FILE
        path, _ = QFileDialog.getOpenFileName(self, "Hit Sesi Seç", str(APP_DIR), "Wave Files (*.wav)")
        if path:
            HIT_SOUND_FILE = Path(path)
            QMessageBox.information(self, "Bilgi", f"Yeni hit sesi seçildi:\n{path}")

    def toggle_theme(self):
        self.dark_mode = not self.dark_mode
        if self.dark_mode:
            self.setStyleSheet(DARK_QSS)
        else:
            self.setStyleSheet(LIGHT_QSS)

    def choose_combo(self):
        path, _ = QFileDialog.getOpenFileName(self, "Combo Seç", str(APP_DIR), "Text Files (*.txt)")
        if path:
            self.combo_path.setText(path)

    def add_combo(self):
        p = self.combo_path.text().strip()
        if not p:
            QMessageBox.warning(self, "Uyarı", "Önce bir combo dosyası seçin.")
            return
        name, ok = QInputDialog.getText(self, "Hızlı Liste", "Liste adı:")
        if not ok or not name.strip():
            return
        combos = load_combos()
        combos.append({"name": name.strip(), "path": p, "date": datetime.now().strftime("%Y-%m-%d %H:%M")})
        save_combos(combos)

    def pick_combo(self):
        combos = load_combos()
        dlg = TableManagerDialog("Hızlı Liste", combos, [("name", "İsim"), ("path", "Yol"), ("date", "Tarih")], self)
        if dlg.exec() == QDialog.Accepted:
            rec = dlg.selected_record()
            if rec:
                self.combo_path.setText(str(rec.get("path", "")))
        save_combos(dlg.records)

    def save_server(self):
        addr = self.server_input.text().strip()
        if not addr:
            QMessageBox.warning(self, "Uyarı", "Server adresi boş olamaz.")
            return
        name, ok = QInputDialog.getText(self, "Server", "Server adı:")
        if not ok or not name.strip():
            return
        servers = load_servers()
        servers.append({"name": name.strip(), "address": addr, "date": datetime.now().strftime("%Y-%m-%d %H:%M")})
        save_servers(servers)

    def pick_server(self):
        servers = load_servers()
        dlg = TableManagerDialog("Server", servers, [("name", "İsim"), ("address", "Adres"), ("date", "Tarih")], self)
        if dlg.exec() == QDialog.Accepted:
            rec = dlg.selected_record()
            if rec:
                self.server_input.setText(str(rec.get("address", "")))
        save_servers(dlg.records)

    def start_scan(self):
        if self.is_scanning:
            QMessageBox.warning(self, "Uyarı", "Tarama zaten devam ediyor.")
            return

        self.clear_hits()

        combo = self.combo_path.text().strip()
        if not Path(combo).exists():
            QMessageBox.warning(self, "Uyarı", "Geçerli bir combo dosyası seçin.")
            return
        server = self.server_input.text().strip()
        if not server:
            QMessageBox.warning(self, "Uyarı", "Server adresi boş olamaz.")
            return

        try:
            lines = Path(combo).read_text(encoding="utf-8", errors="ignore").splitlines()
        except Exception as e:
            QMessageBox.critical(self, "Hata", f"Combo okunamadı:\n{e}")
            return

        pairs: List[tuple] = []
        for ln in lines:
            ln = ln.strip()
            if ":" in ln:
                u, p = (x.strip() for x in ln.split(":", 1))
                if u and p:
                    pairs.append((u, p))
        
        if not pairs:
            QMessageBox.warning(self, "Uyarı", "Combo içinde geçerli satır yok.")
            return

        self.remaining_pairs = pairs[:]
        self.total_accounts = len(self.remaining_pairs)
        self.done_accounts = 0
        
        self.scanner_server = server
        self.scanner_timeout = self.spin_timeout.value()
        self.scanner_get_cats = self.chk_cat.isChecked()
        
        self.is_scanning = True
        self.is_paused = False
        self.update_ui_state()
        self.chk_sound.setEnabled(True)

        self.progress.setMaximum(self.total_accounts)
        self.progress.setValue(0)
        self.lbl_progress.setText(f"0 / {self.total_accounts}")
        self.setWindowTitle("IPTV Combo Tarayıcı (Tarama Başlatıldı...)")

        self.scanner = AsyncScanner(
            server=self.scanner_server,
            pairs=self.remaining_pairs,
            timeout_s=self.scanner_timeout,
            get_cats=self.scanner_get_cats
        )
        self.scanner.set_concurrency(self.slider_bot.value())
        self.scanner.hit.connect(self.on_hit)
        self.scanner.progress_tick.connect(self.on_progress)
        self.scanner.finished.connect(self.on_scan_finished)
        self.scanner.connection_error.connect(self.on_scanner_connection_error)
        self.scanner.start(self)
        
    def on_scanner_connection_error(self, message: str):
        if self.scanner:
            self.scanner.stop() 
        self._has_error_occurred = True
        self._error_message = message

    def handle_pause_click(self):
        if self.is_paused:
            self.resume_scan()
        else:
            self.pause_scan()

    def pause_scan(self):
        if self.scanner:
            self.is_paused = True
            self.scanner.stop()
            self.update_ui_state()
            self.setWindowTitle("IPTV Combo Tarayıcı (Duraklatıldı)")

    def resume_scan(self):
        if not self.remaining_pairs:
            QMessageBox.information(self, "Bilgi", "Devam edilecek hesap kalmadı.")
            self.on_scan_finished()
            return
            
        self.is_paused = False
        self.is_scanning = True
        self.update_ui_state()

        self.setWindowTitle("IPTV Combo Tarayıcı (Tarama Devam Ediyor...)")
        self.scanner = AsyncScanner(
            server=self.scanner_server,
            pairs=self.remaining_pairs,
            timeout_s=self.scanner_timeout,
            get_cats=self.scanner_get_cats
        )
        self.scanner.set_concurrency(self.slider_bot.value())
        self.scanner.hit.connect(self.on_hit)
        self.scanner.progress_tick.connect(self.on_progress)
        self.scanner.finished.connect(self.on_scan_finished)
        self.scanner.connection_error.connect(self.on_scanner_connection_error)
        self.scanner.start(self)

    def stop_scan(self):
        if self.scanner:
            self.scanner.stop()
        self.is_scanning = False
        self.is_paused = False
        self.remaining_pairs.clear()
        QMessageBox.information(self, "İptal Edildi", "Tarama işlemi iptal edildi.")
        self.on_scan_finished()

    def update_ui_state(self):
        self.btn_start.setEnabled(not self.is_scanning and not self.is_paused)
        self.btn_pause.setEnabled(self.is_scanning or self.is_paused)
        self.btn_stop.setEnabled(self.is_scanning or self.is_paused)
        self.btn_clear.setEnabled(not self.is_scanning and not self.is_paused)
        self.combo_path.setEnabled(not self.is_scanning and not self.is_paused)
        self.server_input.setEnabled(not self.is_scanning and not self.is_paused)
        self.chk_sound.setEnabled(self.is_scanning or self.is_paused)
        self.slider_bot.setEnabled(not self.is_scanning and not self.is_paused)
        
        if self.is_paused:
            self.btn_pause.setText("Devam Et")
            self.btn_pause.setIcon(icon("baslat.png"))
            self.lbl_progress.setText(f"Duraklatıldı... {self.done_accounts} / {self.total_accounts}")
        else:
            self.btn_pause.setText("Duraklat")
            self.btn_pause.setIcon(icon("durdur.png"))
            self.lbl_progress.setText(f"{self.done_accounts} / {self.total_accounts}")

    def on_scan_finished(self):
        self.is_scanning = False
        if self.scanner:
            self.scanner = None 
        
        self.update_ui_state()
        self.chk_sound.setEnabled(True)

        if self._has_error_occurred:
            QMessageBox.warning(self, "Bağlantı Hatası", self._error_message)
            self._has_error_occurred = False
            self._error_message = ""
            self.setWindowTitle("IPTV Combo Tarayıcı (Hata)")
        elif not self.is_paused:
            self.setWindowTitle("IPTV Combo Tarayıcı (Bitti)")

    def on_progress(self, inc: int):
        self.done_accounts += inc
        self.progress.setValue(self.done_accounts)
        
        self.lbl_progress.setText(f"{self.done_accounts} / {self.total_accounts}")

    def clear_hits(self, soft=False):
        self.hits.clear()
        self.filtered_cache.clear()
        self.link_counter = 0
        self.hit_box.clear()
        self.hit_label.setText(f"Bulunan HIT sayısı: 0")
        if not self.is_scanning:
            self.progress.setMaximum(1)
            self.progress.setValue(0)
            self.lbl_progress.setText("0 / 0")
        self.cbo_max_conn.blockSignals(True)
        self.cbo_max_conn.clear()
        self.cbo_max_conn.addItem("Max bağlantı: Tümü", userData=None)
        self.cbo_max_conn.blockSignals(False)

    def on_hit(self, hit: Dict[str, Any]):
        self.link_counter += 1
        hit["_link_no"] = self.link_counter
        self.hits.append(hit)
        self._refresh_max_conn_items()
        self.render_hits()

    def _refresh_max_conn_items(self):
        vals = sorted({int(h.get("max_connections", 0)) for h in self.hits})
        cur = self.cbo_max_conn.currentData()
        self.cbo_max_conn.blockSignals(True)
        self.cbo_max_conn.clear()
        self.cbo_max_conn.addItem("Max bağlantı: Tümü", userData=None)
        for v in vals:
            self.cbo_max_conn.addItem(f"Max bağlantı: {v}", userData=v)
        if cur is not None:
            idx = self.cbo_max_conn.findData(cur)
            if idx >= 0:
                self.cbo_max_conn.setCurrentIndex(idx)
        self.cbo_max_conn.blockSignals(False)

    def _apply_filters(self, rows: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
        hide_adult = self.chk_hide_adult.isChecked()
        only_tr    = self.chk_only_tr.isChecked()
        sel_max    = self.cbo_max_conn.currentData()

        out = []
        for h in rows:
            cats = h.get("categories", []) or []
            if hide_adult:
                up = " | ".join(cats).upper()
                if ("ADULT" in up) or ("+18" in up):
                    continue
            if only_tr:
                if not any(c.strip().upper().startswith("TR") for c in cats):
                    continue
            if sel_max is not None and int(h.get("max_connections", 0)) != int(sel_max):
                continue
            out.append(h)
        return out

    def render_hits(self):
        filtered = self._apply_filters(self.hits)
        self.hit_box.clear()
        self.filtered_cache.clear()
        for h in filtered:
            html = self._hit_to_html(h)
            self.hit_box.append(html + "<hr>")
            self.filtered_cache.append(html)
        self.hit_label.setText(f"Bulunan HIT sayısı: {len(filtered)}")

    def _hit_to_html(self, h: Dict[str, Any]) -> str:
        server = h.get("server", "")
        user = h.get("username", "")
        pwd = h.get("password", "")
        link_no = h.get("_link_no", 1)
        m3u_url = build_m3u_url(server, user, pwd)
        lines = [
            f"🔗 {link_no}",
            m3u_url,
            f"DURUM : {h.get('status', '')}",
            f"KULLANICI ADI : {user}",
            f"ŞİFRE : {pwd}",
            f"MAKSİMUM BAĞLANTI : {h.get('max_connections', 0)}",
            f"AKTİF BAĞLANTI : {h.get('active_cons', 0)}",
            f"DENEME : {'Evet' if h.get('trial', False) else 'Hayır'}",
            f"Oluşturulma Tarihi (UTC) : {h.get('created_at', '-')}",
            f"Bitiş Tarihi (UTC) : {h.get('exp_date', '-')}",
            f"İzin Verilen Çıktılar : {h.get('outputs', '-')}",
        ]
        cats = h.get("categories", [])
        if cats:
            lines.append("📺 Kanallar : " + "► " + "► ".join(cats))
        return "<br>".join(lines)

    def save_hits_to_file(self):
        if not self.filtered_cache:
            QMessageBox.information(self, "Bilgi", "Kaydedilecek içerik yok.")
            return
        path, _ = QFileDialog.getSaveFileName(self, "HIT'leri Kaydet", str(APP_DIR / "hits.txt"), "Text Files (*.txt)")
        if not path:
            return
        with open(path, "w", encoding="utf-8") as f:
            for html in self.filtered_cache:
                f.write(html.replace("<br>", "\n").replace("<hr>", "\n" + "-" * 40 + "\n"))
                f.write("\n" + "-" * 40 + "\n")


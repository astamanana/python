def norm_server_url(server_addr: str) -> str:
    s = server_addr.strip()
    if not s:
        return ""
    if not (s.startswith("http://") or s.startswith("https://")):
        s = "http://" + s
    return s.rstrip("/")

def format_ts_utc(ts: Any) -> str:
    try:
        t = int(ts)
        dt = datetime.fromtimestamp(t, tz=timezone.utc)
        return dt.strftime('%d.%m.%Y %H:%M:%S')
    except Exception:
        return "-"

def build_m3u_url(server_addr: str, user: str, pwd: str) -> str:
    base = norm_server_url(server_addr)
    if not base:
        return ""
    return f"{base}/get.php?username={user}&password={pwd}&type=m3u_plus"

class AsyncScanner(QObject):
    hit = Signal(dict)
    progress_tick = Signal(int)
    finished = Signal()
    connection_error = Signal(str)

    def __init__(self, server: str, pairs: List[tuple], timeout_s: int, get_cats: bool):
        super().__init__()
        self.server = server
        self.pairs = pairs
        self.timeout_s = timeout_s
        self.get_cats = get_cats
        self._thread: Optional[QThread] = None
        self._cancel_event = asyncio.Event()
        self._desired_concurrency = 10
        self._tasks: List[asyncio.Task] = []
        self._main_win = None

    def set_concurrency(self, n: int):
        self._desired_concurrency = max(1, int(n))

    def start(self, main_win):
        self._main_win = main_win
        t = QThread()
        t.run = self._thread_entry
        t.finished.connect(self.finished)
        self._thread = t
        t.start()

    def stop(self):
        if self._thread and self._thread.isRunning():
            self._cancel_event.set()

    def _thread_entry(self):
        try:
            asyncio.run(self._main())
        except asyncio.CancelledError:
            pass
        finally:
            pass

    async def _main(self):
        self._cancel_event.clear()
        timeout = aiohttp.ClientTimeout(total=self.timeout_s)
        connector = aiohttp.TCPConnector(limit=0)
        
        try: 
            async with aiohttp.ClientSession(timeout=timeout, connector=connector) as session:
                sem = asyncio.Semaphore(self._desired_concurrency)
                pairs_iter = iter(self.pairs)

                async def auth_and_emit():
                    try:
                        while not self._cancel_event.is_set():
                            try:
                                user, pwd = next(pairs_iter)
                            except StopIteration:
                                return 
                            
                            async with sem:
                                if self._cancel_event.is_set():
                                    return
                                
                                hit = await self._check_one(session, user, pwd)
                                if hit:
                                    if self._main_win and self._main_win.chk_sound.isChecked():
                                        play_hit_sound()
                                    self.hit.emit(hit)

                                if not self._cancel_event.is_set():
                                    self.progress_tick.emit(1)
                    
                    except asyncio.CancelledError:
                        pass
                    except aiohttp.ClientConnectorError:
                        self.connection_error.emit("Lütfen server adresini kontrol edin.")
                        self._cancel_event.set()
                    except aiohttp.ClientError as e:
                        error_msg = str(e).lower()
                        if "dns" in error_msg or "cannot connect" in error_msg or "connection refused" in error_msg:
                            self.connection_error.emit("Lütfen server adresini kontrol edin.")
                        else:
                            self.connection_error.emit(f"Sunucuya bağlanırken beklenmedik bir hata oluştu: {e}. Lütfen server adresini kontrol edin.")
                        self._cancel_event.set()
                    except Exception as e:
                        print(f"Beklenmedik bir hata: {e}")

                async def adjuster():
                    last = self._desired_concurrency
                    while not self._cancel_event.is_set():
                        cur = self._desired_concurrency
                        if cur != last:
                            if cur > last:
                                for _ in range(cur - last):
                                    sem.release()
                            last = cur
                        await asyncio.sleep(0.15)
                
                tasks = [asyncio.create_task(auth_and_emit()) for _ in range(self._desired_concurrency)]
                adj_task = asyncio.create_task(adjuster())

                await asyncio.gather(*tasks, adj_task, return_exceptions=True)
            
        except asyncio.CancelledError:
            pass
        except Exception as e:
            print(f"Error in AsyncScanner._main: {e}")

    async def _check_one(self, session: aiohttp.ClientSession, user: str, pwd: str) -> Optional[Dict[str, Any]]:
        base = norm_server_url(self.server)
        if not base:
            return None

        async def get_json(url: str) -> Optional[Any]:
            try:
                async with session.get(url) as r:
                    if r.status == 200:
                        ct = r.headers.get("Content-Type", "")
                        if "application/json" in ct:
                            return await r.json(content_type=None)
                        txt = await r.text()
                        with contextlib.suppress(Exception):
                            return json.loads(txt)
                    else:
                        return None 
            except asyncio.CancelledError:
                raise
            except aiohttp.ClientConnectorError:
                raise
            except aiohttp.ClientError:
                raise
            except Exception:
                return None
            return None

        data = await get_json(f"{base}/player_api.php?username={user}&password={pwd}")
        
        if not isinstance(data, dict):
            return None
            
        uinfo = data.get("user_info") or {}
        auth_ok = str(uinfo.get("auth", "0")).lower() in ("1", "true")
        if not auth_ok:
            return None

        cats: List[str] = []
        if self.get_cats:
            c1 = await get_json(f"{base}/player_api.php?username={user}&password={pwd}&action=get_live_categories")
            if isinstance(c1, list):
                for c in c1:
                    if isinstance(c, dict):
                        n = (c.get("category_name") or "").strip()
                        if n: cats.append(n)
            
            if not cats:
                c2 = await get_json(f"{base}/panel_api.php?username={user}&password={pwd}")
                if isinstance(c2, dict):
                    lc = c2.get("categories") or c2.get("live_categories") or []
                    if isinstance(lc, list):
                        for c in lc:
                            if isinstance(c, dict):
                                n = (c.get("category_name") or "").strip()
                                if n: cats.append(n)

            if not cats:
                c3 = await get_json(f"{base}/player_api.php?username={user}&password={pwd}&action=get_live_streams")
                if isinstance(c3, list):
                    for s in c3:
                        if isinstance(s, dict):
                            n = (s.get("category_name") or s.get("category_name_raw") or "").strip()
                            if n: cats.append(n)

            _norm = []
            for x in cats:
                x = " ".join(x.split())
                if x and x not in _norm:
                    _norm.append(x)
            cats = sorted(_norm)

        return {
            "server": base,
            "username": user,
            "password": pwd,
            "status": "Active",
            "max_connections": int(uinfo.get("max_connections", 0) or 0),
            "active_cons": int(uinfo.get("active_cons", 0) or 0),
            "trial": str(uinfo.get("trial", "0")).lower() in ("1", "true"),
            "created_at": format_ts_utc(uinfo.get("created_at", 0)),
            "exp_date": format_ts_utc(uinfo.get("exp_date", '-') or 0),
            "outputs": ", ".join(uinfo.get("allowed_output_formats", []) or ["m3u8", "ts", "rtmp"]),
            "categories": cats,
        }

class TableManagerDialog(QDialog):
    def __init__(self, title, records, columns, parent=None):
        super().__init__(parent)
        self.setWindowTitle(title)
        self.resize(820, 460)
        self.records = records
        self.columns = columns

        self.table = QTableWidget(0, len(columns))
        self.table.setHorizontalHeaderLabels([c[1] for c in columns])
        for i in range(len(columns)):
            self.table.horizontalHeader().setSectionResizeMode(i, QHeaderView.Stretch)
        self.table.setSelectionBehavior(QAbstractItemView.SelectRows)
        self.table.setEditTriggers(QAbstractItemView.NoEditTriggers)
        self.table.itemDoubleClicked.connect(self._dbl_select)

        btn_select = QPushButton(icon("liste.png"), "Seç")
        btn_delete = QPushButton(icon("temizle.png"), "Sil")
        btn_close  = QPushButton(icon("cikis.png"), "Kapat")

        btn_select.clicked.connect(self.accept)
        btn_delete.clicked.connect(self.delete_selected)
        btn_close.clicked.connect(self.reject)

        bl = QHBoxLayout()
        bl.addWidget(btn_select)
        bl.addWidget(btn_delete)
        bl.addStretch()
        bl.addWidget(btn_close)

        lay = QVBoxLayout(self)
        lay.addWidget(self.table)
        lay.addLayout(bl)

        self.populate()

    def populate(self):
        self.table.setRowCount(0)
        for rec in self.records:
            r = self.table.rowCount()
            self.table.insertRow(r)
            for c, (key, _) in enumerate(self.columns):
                self.table.setItem(r, c, QTableWidgetItem(str(rec.get(key, ""))))

    def delete_selected(self):
        row = self.table.currentRow()
        if row < 0:
            return
        if 0 <= row < len(self.records):
            del self.records[row]
        self.populate()

    def _dbl_select(self, item: QTableWidgetItem):
        self.table.selectRow(item.row())
        self.accept()

    def selected_record(self):
        row = self.table.currentRow()
        if row < 0:
            return None
        return self.records[row] if 0 <= row < len(self.records) else None

